# DecalForge Environment Variables

# ==============================================
# REQUIRED - Core Configuration
# ==============================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://decalforge.com
NEXT_PUBLIC_APP_NAME=DecalForge

# Database (Neon Postgres - FREE: https://neon.tech)
# Sign up for free 500MB database
DATABASE_URL=postgresql://user:password@host:5432/decalforge?sslmode=require

# ==============================================
# AUTHENTICATION (NextAuth.js)
# ==============================================

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-super-secret-key-here

# GitHub OAuth (FREE - https://github.com/settings/developers)
# Create OAuth App for social login
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# ==============================================
# EMAIL SERVICE (Resend - FREE 100/day)
# ==============================================

# Resend API (FREE: https://resend.com)
# Free: 100 emails/day, 3,000/month
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@your-domain.com

# ==============================================
# AI IMAGE GENERATION
# ==============================================

# Replicate (FREE $5 credit: https://replicate.com)
# ~500-1000 images with free credits, then ~$0.002-0.005 per image
REPLICATE_API_TOKEN=r8_...

# OpenAI DALL-E (PAID: https://platform.openai.com)
# Optional - ~$0.04 per image
OPENAI_API_KEY=sk-...

# Nano Banana (if you have it)
NANOBANANA_API_KEY=your-key-here

# ==============================================
# FILE STORAGE (Vercel Blob - FREE 1GB)
# ==============================================

# Vercel Blob (FREE: Auto-configured in Vercel)
# Free: 1GB storage, auto-configured when you create blob store
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ==============================================
# RATE LIMITING (Upstash - FREE 10K req/day)
# ==============================================

# Upstash Redis (FREE: https://upstash.com)
# Free: 10,000 requests/day
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ==============================================
# OPTIONAL - Shopify Integration
# ==============================================

# Shopify Storefront API (optional - for displaying products)
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# Shopify Admin API (optional - for draft orders)
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
SHOPIFY_APP_URL=https://your-store.myshopify.com/apps/decalforge
SHOPIFY_SCOPES=read_products,write_products,read_draft_orders,write_draft_orders

# ==============================================
# DEVELOPMENT
# ==============================================

# Node Environment
NODE_ENV=development
