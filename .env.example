# DecalForge Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://decalforge.com
NEXT_PUBLIC_APP_NAME=DecalForge

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host:5432/decalforge?sslmode=require

# Image Generation Providers (at least one required, or will use placeholders)
OPENAI_API_KEY=sk-...
NANOBANANA_API_KEY=your-key-here

# Storage (S3/R2 - optional, will use local storage in dev)
STORAGE_BUCKET_URL=https://your-bucket.r2.cloudflarestorage.com
STORAGE_SIGNING_KEY=your-signing-key
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=auto

# Shopify Integration (optional)
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
SHOPIFY_APP_URL=https://your-store.myshopify.com/apps/decalforge
SHOPIFY_SCOPES=read_products,write_products,read_draft_orders,write_draft_orders,read_files,write_files

# Node Environment
NODE_ENV=development
