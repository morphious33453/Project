# =============================================================================
# NSO Trust Index - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development or .env for production
# Replace all placeholder values with your actual credentials

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# PostgreSQL connection string
# For Neon: Get this from your Neon project dashboard
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require

# =============================================================================
# SITE CONFIGURATION (REQUIRED)
# =============================================================================
# The base URL of your deployed site
# Local: http://localhost:3000
# Production: https://trust.niagarastandsout.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# CRON AUTHENTICATION (REQUIRED)
# =============================================================================
# Secret token for authenticating cron job requests
# Generate a secure random string for production
# Used in Authorization header: Bearer YOUR_CRON_SECRET
CRON_SECRET=your-secure-random-secret-here

# =============================================================================
# STRIPE PAYMENT LINKS (REQUIRED FOR CLAIM FLOW)
# =============================================================================
# Create these in your Stripe Dashboard under Payment Links
# Each tier should have a corresponding Stripe Payment Link

# Alerts Tier - Basic email notifications
CLAIM_LINK_ALERTS=https://buy.stripe.com/your-alerts-link

# Pro Tier - Dashboard access + tools
CLAIM_LINK_PRO=https://buy.stripe.com/your-pro-link

# Premium Tier - Advanced features
CLAIM_LINK_PREMIUM=https://buy.stripe.com/your-premium-link

# Benchmark Tier - Full analytics
CLAIM_LINK_BENCHMARK=https://buy.stripe.com/your-benchmark-link

# =============================================================================
# SEO & ANALYTICS (OPTIONAL)
# =============================================================================
# Google Search Console verification code
# Get from: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=your-verification-code

# Google Analytics 4 Measurement ID (Optional)
# Get from: https://analytics.google.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =============================================================================
# DEVELOPMENT (OPTIONAL)
# =============================================================================
# Node environment (development|production|test)
# NODE_ENV=development

# Enable verbose logging
# DEBUG=true
