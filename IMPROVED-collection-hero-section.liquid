{% comment %}
  Enhanced Collection Hero Section
  Features: Fixed image rendering, CTA, SEO optimization, structured data, accessibility
{% endcomment %}

{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .collection-hero-enhanced {
    --hero-min-height: 500px;
    --hero-padding-top: 4rem;
    --hero-padding-bottom: 4rem;
  }

  @media screen and (max-width: 749px) {
    .collection-hero-enhanced {
      --hero-min-height: 400px;
      --hero-padding-top: 3rem;
      --hero-padding-bottom: 3rem;
    }
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }

  .collection-hero-enhanced {
    position: relative;
    min-height: var(--hero-min-height);
    display: flex;
    align-items: center;
    padding-top: var(--hero-padding-top);
    padding-bottom: var(--hero-padding-bottom);
    overflow: hidden;
  }

  .collection-hero__background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .collection-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.2) 100%);
    z-index: 1;
  }

  .collection-hero__content {
    position: relative;
    z-index: 2;
    max-width: 750px;
    text-align: {{ section.settings.text_alignment }};
  }

  .collection-hero__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    font-weight: 700;
    color: {{ section.settings.show_collection_image ? '#ffffff' : 'inherit' }};
    text-shadow: {{ section.settings.show_collection_image ? '2px 2px 4px rgba(0,0,0,0.3)' : 'none' }};
  }

  .collection-hero__description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    margin-bottom: 2rem;
    color: {{ section.settings.show_collection_image ? '#ffffff' : 'inherit' }};
    text-shadow: {{ section.settings.show_collection_image ? '1px 1px 2px rgba(0,0,0,0.3)' : 'none' }};
  }

  .collection-hero__cta-wrapper {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
    margin-top: 2rem;
  }

  .collection-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2.5rem;
    background: {{ section.settings.button_primary_bg | default: '#000000' }};
    color: {{ section.settings.button_primary_text | default: '#ffffff' }};
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    border-radius: 4px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .collection-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    background: {{ section.settings.button_primary_bg | default: '#000000' | color_darken: 10 }};
  }

  .collection-hero__cta--secondary {
    background: transparent;
    color: {{ section.settings.show_collection_image ? '#ffffff' : '#000000' }};
    border: 2px solid currentColor;
  }

  .collection-hero__cta--secondary:hover {
    background: {{ section.settings.show_collection_image ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)' }};
  }

  .collection-hero__stats {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
  }

  .collection-hero__stat {
    text-align: center;
  }

  .collection-hero__stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: {{ section.settings.show_collection_image ? '#ffffff' : 'inherit' }};
  }

  .collection-hero__stat-label {
    display: block;
    font-size: 0.9rem;
    color: {{ section.settings.show_collection_image ? 'rgba(255,255,255,0.9)' : 'inherit' }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .collection-hero__breadcrumbs {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .collection-hero__breadcrumbs a {
    color: {{ section.settings.show_collection_image ? 'rgba(255,255,255,0.8)' : 'inherit' }};
    text-decoration: none;
  }

  .collection-hero__breadcrumbs a:hover {
    text-decoration: underline;
  }

  .collection-hero__trust-badges {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
    align-items: center;
  }

  .collection-hero__trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: {{ section.settings.show_collection_image ? 'rgba(255,255,255,0.9)' : 'inherit' }};
  }

  .collection-hero__trust-badge svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .collection-hero__content {
      text-align: center;
    }

    .collection-hero__cta-wrapper,
    .collection-hero__stats,
    .collection-hero__trust-badges {
      justify-content: center;
    }
  }
{%- endstyle -%}

{%- liquid
  assign show_image = false
  if section.settings.show_collection_image and collection.image
    assign show_image = true
  endif

  assign products_count = collection.products_count
  assign has_description = false
  if section.settings.show_collection_description and collection.description != blank
    assign has_description = true
  endif
-%}

<div class="collection-hero-enhanced{% if show_image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient"
     itemscope
     itemtype="https://schema.org/CollectionPage">

  {%- if show_image -%}
    <img
      class="collection-hero__background-image"
      srcset="
        {%- if collection.image.width >= 375 -%}{{ collection.image | image_url: width: 375 }} 375w,{%- endif -%}
        {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if collection.image.width >= 1100 -%}{{ collection.image | image_url: width: 1100 }} 1100w,{%- endif -%}
        {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
        {%- if collection.image.width >= 1780 -%}{{ collection.image | image_url: width: 1780 }} 1780w,{%- endif -%}
        {%- if collection.image.width >= 2000 -%}{{ collection.image | image_url: width: 2000 }} 2000w,{%- endif -%}
        {%- if collection.image.width >= 3000 -%}{{ collection.image | image_url: width: 3000 }} 3000w,{%- endif -%}
        {{ collection.image | image_url }} {{ collection.image.width }}w
      "
      sizes="100vw"
      src="{{ collection.image | image_url: width: 1500 }}"
      alt="{{ collection.image.alt | escape | default: collection.title }}"
      width="{{ collection.image.width }}"
      height="{{ collection.image.height }}"
      loading="eager"
      fetchpriority="high"
      itemprop="image"
    >
    <div class="collection-hero__overlay"></div>
  {%- endif -%}

  <div class="page-width">
    <div class="collection-hero__inner {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="collection-hero__content">

        {%- if section.settings.show_breadcrumbs -%}
          <nav class="collection-hero__breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
            <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ routes.root_url }}" itemprop="item">
                <span itemprop="name">Home</span>
              </a>
              <meta itemprop="position" content="1" />
            </span>
            <span aria-hidden="true"> / </span>
            <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ routes.collections_url }}" itemprop="item">
                <span itemprop="name">Collections</span>
              </a>
              <meta itemprop="position" content="2" />
            </span>
            <span aria-hidden="true"> / </span>
            <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span itemprop="name">{{ collection.title }}</span>
              <meta itemprop="position" content="3" />
            </span>
          </nav>
        {%- endif -%}

        <h1 class="collection-hero__title" itemprop="name">
          {{- collection.title | escape -}}
        </h1>

        {%- if has_description -%}
          <div class="collection-hero__description rte" itemprop="description">
            {{ collection.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_product_count -%}
          <div class="collection-hero__stats">
            <div class="collection-hero__stat">
              <span class="collection-hero__stat-number">{{ products_count }}</span>
              <span class="collection-hero__stat-label">
                {%- if products_count == 1 -%}
                  Product Available
                {%- else -%}
                  Products Available
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_cta -%}
          <div class="collection-hero__cta-wrapper">
            <a href="#product-grid"
               class="collection-hero__cta collection-hero__cta--primary"
               aria-label="{{ section.settings.cta_text | default: 'Shop Now' }} - {{ collection.title }}">
              {{ section.settings.cta_text | default: 'Shop Now' }}
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            {%- if section.settings.show_secondary_cta and section.settings.secondary_cta_url != blank -%}
              <a href="{{ section.settings.secondary_cta_url }}"
                 class="collection-hero__cta collection-hero__cta--secondary"
                 aria-label="{{ section.settings.secondary_cta_text }}">
                {{ section.settings.secondary_cta_text | default: 'Learn More' }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_trust_badges -%}
          <div class="collection-hero__trust-badges">
            <div class="collection-hero__trust-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 7L9 18L4 13"/>
              </svg>
              <span>Premium Quality</span>
            </div>
            <div class="collection-hero__trust-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2"/>
                <path d="M1 10h22"/>
              </svg>
              <span>Secure Checkout</span>
            </div>
            <div class="collection-hero__trust-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Fast Shipping</span>
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>

  {%- comment -%} Structured Data for SEO {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | json }},
    {% if collection.image %}
    "image": {
      "@type": "ImageObject",
      "url": {{ collection.image | image_url: width: 1200 | json }},
      "width": {{ collection.image.width | json }},
      "height": {{ collection.image.height | json }}
    },
    {% endif %}
    "url": {{ shop.url | append: collection.url | json }},
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Collections",
          "item": {{ shop.url | append: routes.collections_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }
      ]
    },
    "numberOfItems": {{ collection.products_count | json }},
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ collection.products_count | json }}
    }
  }
  </script>
</div>

{%- comment -%} Smooth Scroll Script {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctaButton = document.querySelector('.collection-hero__cta--primary');
    if (ctaButton && ctaButton.getAttribute('href') === '#product-grid') {
      ctaButton.addEventListener('click', function(e) {
        e.preventDefault();
        const productGrid = document.getElementById('product-grid') ||
                           document.querySelector('.collection') ||
                           document.querySelector('[id*="product"]');
        if (productGrid) {
          productGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Collection Hero Enhanced",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "Show collection image as background",
      "info": "Displays collection image as full-width background with overlay"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "default": true,
      "label": "Show product count"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Show breadcrumbs",
      "info": "Improves SEO and navigation"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "default": true,
      "label": "Show call to action button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "default": "Shop Now",
      "label": "Primary CTA text"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_cta",
      "default": false,
      "label": "Show secondary CTA button"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "default": "Learn More",
      "label": "Secondary CTA text"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "header",
      "content": "Trust Elements"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "default": true,
      "label": "Show trust badges",
      "info": "Displays quality, security, and shipping badges for conversion optimization"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Primary button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_primary_text",
      "label": "Primary button text",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Collection Hero Enhanced",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": true,
        "show_product_count": true,
        "show_breadcrumbs": true,
        "show_cta": true,
        "show_trust_badges": true,
        "text_alignment": "center"
      }
    }
  ]
}
{% endschema %}
