            }
          }
        ]
      }
    }
  ]
}
</script>

{%- comment -%} Smooth Scroll Script {%- endcomment -%}
<script>
(function() {
  'use strict';

  // Smooth scroll to products
  document.querySelectorAll('a[href="#led-products"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.querySelector('#led-products') ||
                     document.querySelector('.collection') ||
                     document.querySelector('[id*="product"]');
      if (target) {
        const offset = 100;
        const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    });
  });

  // Track CTA clicks for analytics
  if (typeof gtag !== 'undefined') {
    document.querySelectorAll('.btn-primary, .btn-secondary').forEach(function(btn) {
      btn.addEventListener('click', function() {
        gtag('event', 'cta_click', {
          'event_category': 'LED Signs CTA',
          'event_label': this.textContent.trim(),
          'value': 'Collection Page'
        });
      });
    });
  }
})();
</script>
