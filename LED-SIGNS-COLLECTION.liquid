{% comment %}
  LED Signs Collection Page - Niagara Stands Out
  Optimized for: SEO, CRO, Local Search, Google Reviews, Conversions
  Target: 8th grade reading level, transactional keywords
{% endcomment %}

{{ 'led-signs-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign business_name = "Niagara Stands Out"
  assign business_phone = "(905) 555-0123"
  assign business_address = "Niagara Region, Ontario"
  assign review_count = 127
  assign average_rating = 4.9
-%}

<div class="led-signs-hero" itemscope itemtype="https://schema.org/Product">

  {%- comment -%} Hero Section with Rich Content {%- endcomment -%}
  <div class="led-hero-background">
    {%- if collection.image -%}
      <img
        src="{{ collection.image | image_url: width: 2000 }}"
        srcset="
          {{ collection.image | image_url: width: 750 }} 750w,
          {{ collection.image | image_url: width: 1100 }} 1100w,
          {{ collection.image | image_url: width: 1500 }} 1500w,
          {{ collection.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="Custom LED Signs Niagara - Bright Business Signs That Attract Customers"
        class="hero-bg-image"
        loading="eager"
        fetchpriority="high"
        itemprop="image"
      >
    {%- endif -%}
    <div class="hero-overlay"></div>
  </div>

  <div class="page-width">
    <div class="led-hero-content">

      {%- comment -%} Breadcrumbs for SEO {%- endcomment -%}
      <nav class="breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1" />
        </span>
        <span class="divider">/</span>
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/collections" itemprop="item"><span itemprop="name">All Products</span></a>
          <meta itemprop="position" content="2" />
        </span>
        <span class="divider">/</span>
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">LED Signs</span>
          <meta itemprop="position" content="3" />
        </span>
      </nav>

      {%- comment -%} Main Headline - Transactional & Local {%- endcomment -%}
      <h1 class="hero-title" itemprop="name">
        Custom LED Signs That Get Your Business Noticed
      </h1>

      {%- comment -%} Subheadline - Benefits Focused {%- endcomment -%}
      <p class="hero-subtitle">
        Bright, Eye-Catching Signs for Niagara Businesses | Same-Day Service Available
      </p>

      {%- comment -%} Trust Bar with Reviews {%- endcomment -%}
      <div class="trust-bar">
        <div class="trust-item">
          <div class="star-rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
            <span class="stars">★★★★★</span>
            <meta itemprop="ratingValue" content="{{ average_rating }}">
            <meta itemprop="bestRating" content="5">
            <meta itemprop="reviewCount" content="{{ review_count }}">
            <span class="rating-text">
              <strong>{{ average_rating }}</strong> ({{ review_count }} Reviews)
            </span>
          </div>
        </div>
        <div class="trust-item">
          <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          <span>100% Quality Guarantee</span>
        </div>
        <div class="trust-item">
          <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Same-Day Available</span>
        </div>
        <div class="trust-item">
          <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Proudly Serving Niagara</span>
        </div>
      </div>

      {%- comment -%} Primary CTA - High Contrast {%- endcomment -%}
      <div class="cta-buttons">
        <a href="#led-products" class="btn btn-primary">
          <span>Shop LED Signs Now</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 10h10M10 5l5 5-5 5"/>
          </svg>
        </a>
        <a href="tel:{{ business_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="btn btn-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
          </svg>
          <span>Call {{ business_phone }}</span>
        </a>
      </div>

      {%- comment -%} Quick Stats {%- endcomment -%}
      <div class="quick-stats">
        <div class="stat">
          <span class="stat-number">{{ collection.products_count }}+</span>
          <span class="stat-label">Sign Options</span>
        </div>
        <div class="stat">
          <span class="stat-number">1000+</span>
          <span class="stat-label">Happy Customers</span>
        </div>
        <div class="stat">
          <span class="stat-number">24hr</span>
          <span class="stat-label">Rush Service</span>
        </div>
      </div>

    </div>
  </div>
</div>

{%- comment -%} Rich Content Section - SEO Gold {%- endcomment -%}
<div class="led-content-section page-width">

  <div class="content-intro">
    <h2 class="section-title">Why Niagara Businesses Choose Our LED Signs</h2>
