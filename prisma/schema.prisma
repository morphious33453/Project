// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  designs       Design[]
  licenses      License[]
  downloads     Download[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Design {
  id                 String    @id @default(cuid())
  slug               String    @unique
  prompt             String
  promptHash         String    @map("prompt_hash")
  provider           String    @default("placeholder")
  model              String?
  seed               Int?
  status             DesignStatus @default(GENERATED)
  previewUrl         String?   @map("preview_url")
  printPngUrl        String?   @map("print_png_url")
  cutlineSvgUrl      String?   @map("cutline_svg_url")
  widthMm            Float?    @map("width_mm")
  heightMm           Float?    @map("height_mm")
  tags               String[]
  compatiblePrinters String[]  @map("compatible_printers")
  useCases           String[]  @map("use_cases")
  categories         String[]
  flagged            Boolean   @default(false)
  userId             String?   @map("user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user          User?     @relation(fields: [userId], references: [id])
  licenses      License[]
  downloads     Download[]

  @@index([slug])
  @@index([promptHash])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([compatiblePrinters])
  @@index([useCases])
  @@index([categories])
  @@map("designs")
}

enum DesignStatus {
  GENERATED
  PROCESSED
  LISTED
  FLAGGED
}

model License {
  id           String       @id @default(cuid())
  designId     String       @map("design_id")
  design       Design       @relation(fields: [designId], references: [id])
  userId       String?      @map("user_id")
  user         User?        @relation(fields: [userId], references: [id])
  type         LicenseType
  buyerEmail   String       @map("buyer_email")
  orderId      String?      @map("order_id")
  invoiceUrl   String?      @map("invoice_url")
  downloadKey  String       @unique @default(cuid()) @map("download_key")
  termsVersion String       @default("1.0") @map("terms_version")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([designId])
  @@index([userId])
  @@index([orderId])
  @@index([downloadKey])
  @@map("licenses")
}

model Download {
  id        String   @id @default(cuid())
  designId  String   @map("design_id")
  design    Design   @relation(fields: [designId], references: [id])
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([designId])
  @@index([userId])
  @@index([createdAt])
  @@map("downloads")
}

enum LicenseType {
  STANDARD
  EXTENDED
  EXCLUSIVE
}

model Template {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  svgMaskUrl  String   @map("svg_mask_url")
  previewUrl  String?  @map("preview_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model Product {
  id                String      @id @default(cuid())
  title             String
  description       String?
  price             Float
  type              ProductType
  shopifyProductId  String?     @unique @map("shopify_product_id")
  featured          Boolean     @default(false)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([type])
  @@index([featured])
  @@map("products")
}

enum ProductType {
  PHYSICAL
  DIGITAL
  LICENSE
}

model PrinterModel {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  manufacturer          String
  maxWidthMm            Float    @map("max_width_mm")
  maxHeightMm           Float?   @map("max_height_mm")
  supportsContourCutting Boolean @default(false) @map("supports_contour_cutting")
  description           String?
  setupGuide            String?  @map("setup_guide")
  recommendedMaterials  String[] @map("recommended_materials")
  specs                 Json?
  popular               Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([manufacturer])
  @@index([popular])
  @@map("printer_models")
}

model UseCase {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  title           String
  description     String
  targetAudience  String   @map("target_audience")
  painPoints      String[] @map("pain_points")
  solutions       String[]
  keywords        String[]
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  content         String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([featured])
  @@map("use_cases")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  parentId    String?  @map("parent_id")
  imageUrl    String?  @map("image_url")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([parentId])
  @@index([featured])
  @@index([sortOrder])
  @@map("categories")
}

// SEO Playbook Models

model GlossaryTerm {
  id              String   @id @default(cuid())
  slug            String   @unique
  term            String
  definition      String
  longDescription String?  @map("long_description")
  relatedTerms    String[] @map("related_terms")
  category        String?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  featured        Boolean  @default(false)
  views           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([views])
  @@map("glossary_terms")
}

model FAQ {
  id              String   @id @default(cuid())
  slug            String   @unique
  question        String
  answer          String
  category        String?
  relatedPages    String[] @map("related_pages")
  keywords        String[]
  searchVolume    Int?     @map("search_volume")
  difficulty      Int?
  pageRank        Int      @default(0) @map("page_rank")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([category])
  @@index([pageRank])
  @@index([featured])
  @@map("faqs")
}

model BlogPost {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  excerpt          String?
  content          String
  author           String?
  coverImage       String?  @map("cover_image")
  category         String?
  tags             String[]
  isCornerstone    Boolean  @default(false) @map("is_cornerstone")
  cornerstoneOrder Int?     @map("cornerstone_order")
  parentPostId     String?  @map("parent_post_id")
  relatedPosts     String[] @map("related_posts")
  internalLinks    String[] @map("internal_links")
  metaTitle        String?  @map("meta_title")
  metaDescription  String?  @map("meta_description")
  published        Boolean  @default(false)
  publishedAt      DateTime? @map("published_at")
  views            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([category])
  @@index([isCornerstone])
  @@index([published])
  @@index([publishedAt])
  @@map("blog_posts")
}

model Material {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String
  useCases        String[] @map("use_cases")
  printers        String[]
  finishes        String[]
  properties      Json?
  priceRange      String?  @map("price_range")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([featured])
  @@map("materials")
}

model Software {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  vendor          String
  description     String
  compatibility   String[]
  fileFormats     String[] @map("file_formats")
  priceModel      String?  @map("price_model")
  tutorials       Json?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([featured])
  @@map("software")
}

model PrintMethod {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String
  bestFor         String[] @map("best_for")
  materials       String[]
  equipment       String[]
  processSteps    Json?    @map("process_steps")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([featured])
  @@map("print_methods")
}

