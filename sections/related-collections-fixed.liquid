<!-- Related Collections - Fixed Image Rendering -->
<div class="simple-related-collections">
  <style>
    .simple-related-collections {
      max-width: 1400px;
      margin: 60px auto;
      padding: 0 20px;
    }

    .simple-collections-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .simple-collections-header h2 {
      font-size: 2rem;
      font-weight: 700;
      color: #1a202c;
      margin-bottom: 10px;
    }

    .simple-collections-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .simple-collection-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      transition: all 0.3s;
      text-decoration: none;
      display: block;
    }

    .simple-collection-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.1);
      border-color: #667eea;
    }

    .simple-collection-image {
      width: 100%;
      height: 260px;
      background: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .simple-collection-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      transition: transform 0.3s ease;
    }

    .simple-collection-card:hover .simple-collection-image img {
      transform: scale(1.05);
    }

    .simple-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(102,126,234,0.95);
      color: white;
      padding: 6px 14px;
      border-radius: 16px;
      font-size: 0.75rem;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(102,126,234,0.4);
      backdrop-filter: blur(10px);
    }

    .simple-collection-info {
      padding: 20px;
      background: white;
    }

    .simple-collection-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: #1a202c;
      margin-bottom: 12px;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .simple-collection-link {
      color: #667eea;
      font-weight: 600;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: gap 0.2s;
    }

    .simple-collection-card:hover .simple-collection-link {
      gap: 10px;
    }

    @media (max-width: 768px) {
      .simple-collections-grid {
        grid-template-columns: 1fr;
      }

      .simple-collection-image {
        height: 220px;
        padding: 16px;
      }
    }
  </style>

  {% if section.settings.title != blank %}
    <div class="simple-collections-header">
      <h2>{{ section.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="simple-collections-grid">
    {%- comment -%} Collection 1 {%- endcomment -%}
    {% if section.settings.collection_1 != blank %}
      {% assign col1 = section.settings.collection_1 %}
      <a href="{{ col1.url }}" class="simple-collection-card">
        <div class="simple-collection-image">
          {% if col1.image %}
            {{ col1.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: col1.title }}
          {% elsif col1.products.first.featured_image %}
            {{ col1.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: col1.title }}
          {% else %}
            <div style="width:100%;height:100%;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:4rem;border-radius:8px;">
              {{ col1.title | slice: 0, 1 | upcase }}
            </div>
          {% endif %}
          <div class="simple-badge">{{ col1.products_count }} items</div>
        </div>
        <div class="simple-collection-info">
          <div class="simple-collection-title">{{ col1.title }}</div>
          <span class="simple-collection-link">
            Shop Now
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>
    {% endif %}

